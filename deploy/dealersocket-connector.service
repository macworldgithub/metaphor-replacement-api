[Unit]
Description=DealerSocket read-only connector and hourly lead sync
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=dealersocket
Group=dealersocket
WorkingDirectory=/opt/metaphor-replacement-api
Environment=HOME=/var/lib/dealersocket
Environment=PYTHONUNBUFFERED=1
Environment=DEALERSOCKET_PROFILE_DIR=/var/lib/dealersocket/chrome
Environment=DEALERSOCKET_LEAD_SNAPSHOT_PATH=/var/lib/dealersocket/leads/latest.json
EnvironmentFile=/opt/metaphor-replacement-api/.env
ExecStart=/opt/metaphor-replacement-api/.venv/bin/python /opt/metaphor-replacement-api/run_connector.py
Restart=always
RestartSec=15
TimeoutStopSec=30
KillMode=control-group
UMask=0077
StateDirectory=dealersocket
StateDirectoryMode=0700

[Install]
WantedBy=multi-user.target
