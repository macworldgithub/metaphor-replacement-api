PROJECT_NAME="Metaphor Replacement API"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=true
PORT=8000
HOST="127.0.0.1"

# DealerSocket Automation Config
DEALERSOCKET_USERNAME="your_username_or_email"
DEALERSOCKET_PASSWORD="your_password"
DEALERSOCKET_AUTO_LOGIN_ENABLED=false
DEALERSOCKET_TOTP_SECRET=""
# Exact HTTPS authentication hostnames; never add an unverified redirect host.
DEALERSOCKET_AUTH_HOSTS="bb.dealersocket.com,sso.dealersocket.com,na.login.solera.com"
DEALERSOCKET_AUTH_COOLDOWN_SECONDS=900
DEALERSOCKET_OPPORTUNITIES_URL="https://bb.dealersocket.com/#/crm/employee?todoType=opportunities"

# Portal live-sync target. LEAD_FORWARD_SECRET must match the Nest backend.
DEALERSOCKET_SYNC_API_URL="https://www.cranbourne-backend.omnisuiteai.com/api/leads/ingest"
LEAD_FORWARD_SECRET="replace-with-a-long-random-secret"

# Read-only connector. The key must match the Nest backend; keep port 8000 private.
DEALERSOCKET_CONNECTOR_KEY="replace-with-a-random-key-at-least-32-characters"
DEALERSOCKET_INTERACTIVE_LOGIN_ENABLED=false
DEALERSOCKET_PROFILE_DIR=".private/dealersocket-chrome"
DEALERSOCKET_LEAD_SYNC_ENABLED=true
DEALERSOCKET_LEAD_SYNC_INTERVAL_SECONDS=1800
DEALERSOCKET_LEAD_SNAPSHOT_PATH=".private/dealersocket-leads/latest.json"
